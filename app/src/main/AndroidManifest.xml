<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      A permissão INTERNET será usada a partir da Fase 3 (catálogo remoto
      e downloads de pacotes de conteúdo via HTTPS). Nenhum dado do usuário
      é coletado ou enviado (ver política de privacidade em Ajustes).
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PlayBoxApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@drawable/ic_playbox"
        android:roundIcon="@drawable/ic_playbox"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.PlayBox">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
